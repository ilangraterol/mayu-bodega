# Copiar a .env y ajustar. Nunca commitear el .env real.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# BCV (tasa oficial,VES por 1 USD)
BCV_RATE_URL=https://mippetro.bcv.org.ve/getDocument/index/3
BCV_RATE_TIMEOUT_SECONDS=15

# Usuarios de ejemplo de `manage.py seed_demo`. Defina una propia fuera de
# desarrollo para no crear cuentas con una contraseña conocida.
MAYU_DEMO_PASSWORD=cambia-esta-clave-en-produccion

# Herramientas de backend/tools/
MAYU_API_URL=http://127.0.0.1:8000
MAYU_USERNAME=admin
MAYU_PASSWORD=
